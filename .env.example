# ==========================================
# MODELO DE CONFIGURAÇÃO (.env.example)
# Copie este arquivo para .env e preencha suas senhas reais
# ==========================================

# 1. Configurações do Banco de Dados PostgreSQL
POSTGRES_DB=tutaspaper_db
POSTGRES_USER=tutas_admin
POSTGRES_PASSWORD=sua_senha_segura_aqui
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# 2. Configurações da API Backend (Node.js/Express)
BACKEND_PORT=5000
NODE_ENV=production
JWT_SECRET=sua_chave_jwt_secreta_aqui
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu-token-real-mercadopago

# 3. Configurações do WhatsApp (Evolution Go em Golang)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_chave_global_evolution_aqui
EVOLUTION_SERVER_PORT=8080

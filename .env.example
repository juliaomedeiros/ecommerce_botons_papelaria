# Exemplo de Variáveis de Ambiente para o Tuta's Paper
# Copie este arquivo para .env e preencha com seus dados reais

PORT=5000
NODE_ENV=production

# Banco de Dados PostgreSQL
DATABASE_URL=postgres://tutas_admin:sua_senha_aqui@postgres:5432/tutaspaper_db

# Chave Segura JWT de Autenticação Admin
JWT_SECRET=sua_chave_jwt_secreta_aqui

# Mercado Pago Integracao
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu-access-token-aqui

# WhatsApp Evolution API (Evolution Go)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_chave_global_evolution_aqui
